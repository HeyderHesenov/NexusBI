# Production secrets for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#
# .env.prod is gitignored. Never commit a filled-in copy: the signing key in it
# forges sessions and the Fernet key decrypts every stored datasource password.

# ─── Database ───
POSTGRES_USER=nexusbi
POSTGRES_PASSWORD=            # openssl rand -base64 24
POSTGRES_DB=nexusbi

# ─── Application secrets (the app refuses to start without these) ───
# Signs access and refresh tokens. Must be at least 32 characters.
SECRET_KEY=                   # openssl rand -base64 48
# Encrypts stored datasource credentials at rest. Must be a Fernet key.
FERNET_KEY=                   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Verifies trained AutoML models before unpickling them. Leave empty and one is
# minted on first boot beside the uploads volume; set it explicitly if you run
# more than one host, or each host will reject the others' models.
MODEL_SIGNING_KEY=            # openssl rand -base64 32

# ─── AI engine (optional) ───
# Leave empty and NexusBI still runs: every AI feature falls back to its
# deterministic engine, /ready reports "ai": "degraded", and no model calls are
# made. Set both to switch the real engine on.
AI_API_KEY=
AI_MODEL=

# ─── AI spend control ───
# Prices are USD per 1M tokens, copied from the engine's pricing page (gpt-4o
# was 2.50 / 10.00 on 2026-07-30). Leaving them at 0 makes every call cost 0,
# which silently disables the ceiling below — the app warns about that at
# startup. At the ceiling, AI switches to its deterministic fallbacks for the
# rest of the UTC day; /ready reports it. 0 disables the ceiling entirely.
AI_PRICE_INPUT_USD_PER_1M=2.50
AI_PRICE_OUTPUT_USD_PER_1M=10.00
AI_PRICE_EMBEDDING_USD_PER_1M=0.02
AI_DAILY_USD_CEILING=10.0

# ─── Hostname and TLS ───
# Set to your public hostname and Caddy obtains and renews a certificate for it
# automatically. The DNS A/AAAA record must already point here, and ports 80 and
# 443 must be reachable, or the ACME challenge fails.
NEXUSBI_SITE_ADDRESS=http://localhost

# ─── Sizing ───
# Uvicorn workers. Scheduler leader election means only one of them runs jobs.
WEB_CONCURRENCY=4
# Edge upload ceiling. Keep >= the backend's UPLOAD_MAX_BYTES (default 10 MB) or
# large uploads fail at the proxy with an opaque 413.
NEXUSBI_MAX_BODY=12MB
