# Build context for deploy/web.Dockerfile, which is rooted here so it can reach
# both frontend/ and deploy/. Everything the SPA build does not need is excluded
# — most importantly backend/data, which holds uploads and signing keys.
.git/
.github/
backend/
docs/
scripts/
node_modules/
frontend/node_modules/
frontend/dist/
frontend/stats.html
frontend/playwright-report/
frontend/test-results/
.playwright-mcp/
.ruff_cache/
*.md
.env
.env.*
!.env.example
!.env.prod.example
