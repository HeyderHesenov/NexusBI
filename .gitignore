# Secrets — NEVER commit
#
# All three forms are needed. `.env` matches only that exact name and `*.env`
# only names ENDING in .env, so neither covers `.env.prod` — the file that holds
# the production signing key and the Fernet key that decrypts every stored
# datasource password. The negations must stay below the patterns they undo.
.env
*.env
.env.*
!.env.example
!.env.prod.example
*.pem
*.key
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Databases / local data
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# Unanchored on purpose: a pattern containing a slash is relative to this file,
# so plain `data/uploads/` covered only <root>/data/uploads. The backend runs
# with cwd=backend and UPLOAD_DIR=./data/uploads, so the directory it actually
# writes to is backend/data/uploads — which the anchored form never matched.
**/data/uploads/

# Node / frontend
node_modules/
dist/
.vite/
*.local
stats.html

# E2E (Playwright)
playwright-report/
test-results/
frontend/playwright/.cache/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
logs/

# Playwright MCP artifacts
.playwright-mcp/

# TS build cache
*.tsbuildinfo

# Local agent/editor config
.claude/

# NL->SQL eval output — regenerated by every pytest run, published as a CI
# artifact. The golden set it scores (backend/tests/golden/) IS tracked.
backend/eval-report.json
