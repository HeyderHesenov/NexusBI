# Where the browser reaches the API. Absolute for the dev server, which runs on a
# different port than the backend.
#
# Production builds use a RELATIVE value instead — see docker-compose.prod.yml,
# which builds with VITE_API_URL=/api/v1. The frontend and backend are served
# from one origin behind Caddy, so a relative base means the same image works on
# any domain (and CORS never enters the picture). WebSocket URLs are derived from
# this value by lib/wsUrl.ts, which resolves relative bases against the page origin.
VITE_API_URL=http://localhost:8000/api/v1
VITE_DEMO_MODE=true
